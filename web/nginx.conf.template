server {
    listen ${PORT};
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${API_URL};
        # The upstream gets its own host name, as Vite's changeOrigin does: behind a Host-routed ingress
        # (as in Azure) the API is addressed by its own name, not the browser's.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri /index.html;
    }
}
