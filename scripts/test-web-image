#!/usr/bin/env bash
# Checks the web image's nginx the way a Host-routed ingress would meet it: the upstream must receive its own
# host name (as Vite's changeOrigin does in dev), not the browser's. Builds web/, starts a stand-in upstream that
# answers with the Host header it received, calls it through the web container, and compares.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
tag="todo-web-test-$$"; net="todo-web-test-$$"
cleanup() { docker rm -f "$tag-web" "$tag-up" >/dev/null 2>&1 || true; docker network rm "$net" >/dev/null 2>&1 || true; docker image rm "$tag" >/dev/null 2>&1 || true; }
trap cleanup EXIT
docker build -q -t "$tag" "$root/web" >/dev/null
docker network create "$net" >/dev/null
conf="$(mktemp -d)"; printf 'server { listen 8081; location / { return 200 "$http_host"; } }\n' > "$conf/default.conf"
docker run -d --name "$tag-up" --network "$net" --network-alias upstream -v "$conf/default.conf:/etc/nginx/conf.d/default.conf:ro" nginx:1.27.5-alpine3.21 >/dev/null
docker run -d --name "$tag-web" --network "$net" -e PORT=8000 -e API_URL=http://upstream:8081 -p 127.0.0.1:0:8000 "$tag" >/dev/null
port="$(docker port "$tag-web" 8000/tcp | head -1 | sed -E 's/.*://')"
for _ in $(seq 1 30); do curl -fsS -o /dev/null "http://localhost:$port/api/x" 2>/dev/null && break; sleep 0.5; done
got="$(curl -fsS "http://localhost:$port/api/x")"
echo "browser host: localhost:$port   upstream saw Host: $got"
[ "$got" = "upstream:8081" ] || { echo "FAIL: expected upstream to see Host 'upstream:8081'" >&2; exit 1; }
echo "ok"
